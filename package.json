{
  "name": "od-ordem-de-demandas",
  "version": "1.0.0",
  "description": "OD — Ordem de Demandas | HeuCode. Sistema de registro e acompanhamento de demandas (Express + PostgreSQL, arquitetura MVC).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "node scripts/aplicar-sql.js --schema",
    "db:seed": "node scripts/aplicar-sql.js --seed",
    "db:reset": "node scripts/aplicar-sql.js --schema --seed",
    "admin": "node scripts/criar-admin.js",
    "testar": "node scripts/testar-sistema.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "private": true
}
