<div class="fundo-modal" id="modal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitulo">
    <div class="modal-topo">
      <div>
        <div style="color:var(--primary);font-weight:700;font-size:12.5px" id="modalNumero"></div>
        <h2 id="modalTitulo" style="font-size:19px"></h2>
      </div>
      <button class="fechar" id="btnFecharModal" aria-label="Fechar">&times;</button>
    </div>
    <div class="modal-corpo" id="modalCorpo"></div>
    <div class="modal-rodape">
      <button class="btn btn-perigo btn-sm" id="btnExcluir">Excluir</button>
      <button class="btn btn-sm" id="btnImprimir">Imprimir</button>
      <button class="btn btn-sm" id="btnEditar">Editar</button>
      <button class="btn btn-primario btn-sm" id="btnAvancar">Avançar situação</button>
    </div>
  </div>
</div>

<div id="toasts"></div>
